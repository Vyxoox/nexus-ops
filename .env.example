# .ENV.EXAMPLE — Nexus People & Ops
SECRET_KEY=troque-essa-chave-por-uma-string-aleatoria-segura
DATABASE_URL=sqlite:///gestao_corporativa.db
PORT=8080
ADMIN_PASSWORD=troque-a-senha-do-admin
EMAIL_CORPORATIVO_PADRAO=contato@nexuscorp.com.br

APP_ENV=development
DEBUG=False

# ============================
# Alertas de segurança
# ============================
ALERTAS_HABILITADOS=true
ALERTA_FUSO_HORARIO=America/Sao_Paulo

# Brute force de login
ALERTA_LOGIN_FALHAS_LIMITE=5
ALERTA_LOGIN_FALHAS_JANELA_MIN=5
ALERTA_LOGIN_FALHAS_COOLDOWN_MIN=15
ALERTA_LOGIN_BLOQUEIO_HABILITADO=true
ALERTA_LOGIN_BLOQUEIO_MIN=15
ALERTA_LOGIN_BLOQUEAR_LOCALHOST=false

# Exportação massiva
ALERTA_EXPORTACAO_LIMITE=3
ALERTA_EXPORTACAO_JANELA_MIN=10
ALERTA_EXPORTACAO_COOLDOWN_MIN=20

# Superadmin fora de horário
ALERTA_SUPERADMIN_HORA_INICIO=8
ALERTA_SUPERADMIN_HORA_FIM=18
ALERTA_SUPERADMIN_COOLDOWN_MIN=30
ALERTA_SUPERADMIN_ACOES=AUDITORIA_EXPORTAR_CSV,REINDEXAR_TODOS_SUCESSO,USUARIO_CRIAR_ADMIN_SUCESSO,FUNCIONARIO_INATIVAR_SUCESSO,FUNCIONARIO_REATIVAR_SUCESSO,FUNCIONARIO_EDITAR_SUCESSO,FUNCIONARIO_CADASTRAR_EFETIVO_SUCESSO,FUNCIONARIO_CADASTRAR_TERCEIRIZADO_SUCESSO

SMTP_HOST=smtp.nexuscorp.com.br
SMTP_PORT=587
SMTP_USER=noreply@nexuscorp.com.br
SMTP_PASSWORD=troque-aqui
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT=10
